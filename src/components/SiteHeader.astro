---
/**
 * The federation header (TODO.FULL/02) — the OIML SMART chrome every site
 * renders: brand + the component nav + search + theme + sign-in. Brand
 * props resolve through site-meta's resolveBrand (the one home for the
 * defaults) and thread down to the mobile overlay unchanged.
 */
import MobileNav from './MobileNav.vue'
import NavDropdown from './NavDropdown.vue'
import SearchBox from './SearchBox.vue'
import ThemeToggle from './ThemeToggle.vue'
import AiBubble from './AiBubble.vue'
import { NAV_ITEMS, isLinkActive } from '../data/nav-config'
import { resolveBrand, frontDoor, type BrandProps } from '../data/site-meta'

interface Props extends BrandProps {
  /** Whether the consumer mounted real signin-slot content (an account
   *  chip) — Base threads this so the mobile overlay can drop its
   *  logged-out "Sign in" link. */
  hasSignin?: boolean
  /** The AI assistant bubble (TODO.ai-platform/01) — OFF unless the
   *  consuming property opts in. `true` mounts it against the public
   *  service; the object form overrides the service origin (staging)
   *  and the answer-language hint. `contextChips` (TODO.ai-platform/02)
   *  opts the property into the opt-in context chips + the honest
   *  context line. */
  aiAssistant?: boolean | { apiBase?: string; lang?: string; contextChips?: boolean }
}
const brand = resolveBrand(Astro.props)
const { hasSignin = true } = Astro.props
const path = Astro.url.pathname
const ai = Astro.props.aiAssistant
const aiConfig = ai && typeof ai === 'object' ? ai : {}
---

<header class="site-nav sticky top-0 z-[100] bg-paper-soft dark:bg-paper-deep border-b border-rule">
  <div class="max-w-7xl mx-auto px-6 flex items-center justify-between gap-4 h-14">
    <a href={brand.homeHref} class="nav-brand flex items-center gap-2 no-underline text-ink min-w-0">
      <img src={brand.logoLight} alt="" class="logo-light h-7 w-auto shrink-0" />
      <img src={brand.logoDark} alt="" class="logo-dark h-7 w-auto shrink-0" />
      <span class="font-serif text-base font-semibold tracking-tight truncate">{brand.brandName}</span>
    </a>
    <div class="flex items-center gap-2 sm:gap-4 min-w-0">
      <nav class="nav-menu hidden lg:flex items-center gap-3" id="nav-menu" aria-label="Primary">
        {NAV_ITEMS.map(item => (
          item.type === 'dropdown' ? (
            <NavDropdown client:load config={item.config} currentPath={path} />
          ) : (
            <a
              href={frontDoor(item.href)}
              class={`text-sm font-medium text-ink-soft hover:text-accent transition-colors whitespace-nowrap ${isLinkActive(item.matchPrefix, path) ? 'text-accent font-semibold' : ''}`}
            >{item.label}</a>
          )
        ))}
        <SearchBox client:idle />
        <ThemeToggle client:load />
        {ai && <AiBubble client:load mode="chrome" apiBase={aiConfig.apiBase} lang={aiConfig.lang} contextChips={aiConfig.contextChips} />}
      </nav>
      <!-- Identity, not navigation: the account chip (or the default
           sign-in link) stays visible at EVERY breakpoint — it never
           collapses with the nav. Keep chips compact and shrink-0. -->
      <div class="flex items-center shrink-0">
        <slot name="signin">
          <a href={brand.signInHref} class="shell-signin text-sm font-semibold text-accent whitespace-nowrap shrink-0">Sign in ↗</a>
        </slot>
      </div>
    </div>
    <MobileNav
      client:load
      brandName={brand.brandName}
      logoLight={brand.logoLight}
      logoDark={brand.logoDark}
      homeHref={brand.homeHref}
      signInHref={brand.signInHref}
      show-sign-in={!hasSignin}
    />
  </div>
</header>
