---
/**
 * The house base layout (TODO.FULL/02) — html shell + fonts + tokens +
 * federation header + footer. Consumers wrap their page:
 *   <Base title="…" description="…"><slot /></Base>
 * Tokens come from @oimlsmart/site-shell/tokens.css (the one home for
 * colors and type); the brand resolves through site-meta's resolveBrand
 * so a consumer override threads into header, mobile overlay, and
 * footer together.
 */
import { ClientRouter } from 'astro:transitions'
import SiteHeader from './SiteHeader.astro'
import SiteFooter from './SiteFooter.astro'
import InternalBanner from './InternalBanner.astro'
import { SITE, resolveBrand } from '../data/site-meta'
import { THEME_BOOTSTRAP } from '../composables/useTheme'

interface Props {
  title: string
  description?: string
  siteTitle?: string
  brandName?: string
  logoLight?: string
  logoDark?: string
  /** The sign-in link's target — the consuming service declares its own
   *  auth start (the RP's login route or the identity service's URL);
   *  the default '/login/' is only right for sites with a local one. */
  signInHref?: string
  /** The internal-draft banner — the top site's marking; minisites are public. */
  internal?: boolean
  /** The html lang attribute — bilingual minisites pass their page locale. */
  lang?: string
  /** The AI assistant bubble (TODO.ai-platform/01) — off by default; the
   *  consuming property opts in (`true`) or overrides the service origin
   *  (`{ apiBase }`) for staging. `contextChips` (TODO.ai-platform/02)
   *  opts into the opt-in context chips + the honest context line. */
  aiAssistant?: boolean | { apiBase?: string; lang?: string; contextChips?: boolean }
}
const { title, description, siteTitle = SITE.title, internal = false, lang = SITE.lang, aiAssistant = false } = Astro.props
const brand = resolveBrand(Astro.props)
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle

const FONT_URL =
  'https://fonts.googleapis.com/css2?' +
  'family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700' +
  '&family=IBM+Plex+Sans:wght@300;400;500;600;700' +
  '&family=IBM+Plex+Mono:wght@400;500;600' +
  '&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700' +
  '&display=swap'
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ClientRouter />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={FONT_URL} />
  <meta name="theme-color" content="#004996" />
  <meta name="color-scheme" content="light dark" />
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
  <slot name="head" />
</head>
<body>
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-[400] focus:top-3 focus:left-3 focus:px-4 focus:py-2 focus:rounded focus:bg-paper focus:text-ink focus:border focus:border-rule focus:shadow no-underline">Skip to content</a>
  {internal && <InternalBanner />}
  <SiteHeader
    brandName={brand.brandName}
    logoLight={brand.logoLight}
    logoDark={brand.logoDark}
    homeHref={brand.homeHref}
    signInHref={brand.signInHref}
    hasSignin={Astro.slots.has('signin')}
    aiAssistant={aiAssistant}
  >
      <!-- Forwarded WITH a fallback: an empty passthrough registers the
           slot as provided and suppresses SiteHeader's default link. -->
      <slot name="signin" slot="signin">
        <a href={brand.signInHref} class="shell-signin text-sm font-semibold text-accent whitespace-nowrap">Sign in ↗</a>
      </slot>
    </SiteHeader>
  <main id="main" class="min-h-[calc(100vh-3.5rem-5rem)]">
    <slot />
  </main>
  <SiteFooter brandName={brand.brandName} logoLight={brand.logoLight} logoDark={brand.logoDark} />

  <script is:inline set:html={THEME_BOOTSTRAP} />
</body>
</html>
