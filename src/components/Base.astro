---
/**
 * The house base layout (TODO.FULL/02) — html shell + fonts + tokens +
 * federation header + footer. Consumers wrap their page:
 *   <Base title="…" description="…"><slot /></Base>
 * Tokens come from @oimlsmart/site-shell/tokens.css (the one home for
 * colors and type); logos resolve to the canonical oimlsmart.org URLs.
 */
import { ClientRouter } from 'astro:transitions'
import SiteHeader from './SiteHeader.astro'
import SiteFooter from './SiteFooter.astro'
import InternalBanner from './InternalBanner.astro'


interface Props {
  title: string
  description?: string
  siteTitle?: string
  brandName?: string
  logoLight?: string
  logoDark?: string
  /** The sign-in link's target — the consuming service declares its own
   *  auth start (the RP's login route or the identity service's URL);
   *  the default '/login/' is only right for sites with a local one. */
  signInHref?: string
  /** The internal-draft banner — the top site's marking; minisites are public. */
  internal?: boolean
  /** The html lang attribute — bilingual minisites pass their page locale. */
  lang?: string
}
const { title, description, siteTitle = 'OIML SMART', brandName, logoLight, logoDark, signInHref, internal = false, lang = 'en-US' } = Astro.props
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle

const FONT_URL =
  'https://fonts.googleapis.com/css2?' +
  'family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700' +
  '&family=IBM+Plex+Sans:wght@300;400;500;600;700' +
  '&family=IBM+Plex+Mono:wght@400;500;600' +
  '&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700' +
  '&display=swap'
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ClientRouter />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={FONT_URL} />
  <meta name="theme-color" content="#004996" />
  <meta name="color-scheme" content="light dark" />
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
  <slot name="head" />
</head>
<body>
  {internal && <InternalBanner />}
  <SiteHeader {brandName} {logoLight} {logoDark} {signInHref} />
  <main class="min-h-[calc(100vh-3.5rem-5rem)]">
    <slot />
  </main>
  <SiteFooter />

  <script is:inline>
    var stored = localStorage.getItem('oiml-theme')
    var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
    if (stored === 'dark' || (!stored && prefersDark)) {
      document.documentElement.classList.add('dark')
    }
    document.addEventListener('astro:before-swap', function(e) {
      if (document.documentElement.classList.contains('dark')) {
        e.newDocument.documentElement.classList.add('dark')
      }
    })
  </script>
</body>
</html>
