---
/**
 * ComponentLogo — one OIML SMART component's logo, light/dark swapped by
 * the html.dark class (the same mechanism as every other logo in the
 * shell — a prefers-color-scheme media query here would ignore the manual
 * theme toggle). The assets are the ONE public copy at
 * https://www.oimlsmart.org/img/components/ (TODO.components/01 +
 * TODO.FULL/02: no per-site copies — every site references the canonical
 * URL, so it renders on any origin).
 */
import { COMPONENT_ASSET_BASE } from '../data/site-meta'

interface Props {
  /** The component slug: smart-rec, smart-studio, cs-smart, smi, sst, cnml-box. */
  name: string
  /** One sentence stating what the logo shows (the style guide's rule). */
  alt: string
  /** Pixel width (height follows the viewBox ratio). */
  width?: number
  class?: string
  /** The canonical asset base — override only for staging. */
  base?: string
}

const { name, alt, width = 112, class: className = '', base = COMPONENT_ASSET_BASE } = Astro.props
---

<span class={`component-logo ${className}`}>
  <img src={`${base}/${name}-light.svg`} alt={alt} width={width} loading="lazy" class="component-logo-light" />
  <img src={`${base}/${name}-dark.svg`} alt="" aria-hidden="true" width={width} loading="lazy" class="component-logo-dark" />
</span>

<style>
.component-logo-dark { display: none; }
html.dark .component-logo-light { display: none; }
html.dark .component-logo-dark { display: inline; }
</style>
