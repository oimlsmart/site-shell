---
/**
 * ComponentLogo — one OIML SMART component's logo, light/dark swapped by
 * the color scheme (the brand header's picture pattern). The assets are
 * the ONE public copy at https://www.oimlsmart.org/img/components/
 * (TODO.components/01 + TODO.FULL/02: no per-site copies — every site
 * references the canonical URL, so it renders on any origin).
 */
interface Props {
  /** The component slug: smart-rec, smart-studio, cs-smart, smi, sst, cnml-box. */
  name: string
  /** One sentence stating what the logo shows (the style guide's rule). */
  alt: string
  /** Pixel width (height follows the viewBox ratio). */
  width?: number
  class?: string
  /** The canonical asset base — override only for staging. */
  base?: string
}

const { name, alt, width = 112, class: className = '', base = 'https://www.oimlsmart.org/img/components' } = Astro.props
---

<picture class={`component-logo ${className}`}>
  <source srcset={`${base}/${name}-dark.svg`} media="(prefers-color-scheme: dark)" />
  <img src={`${base}/${name}-light.svg`} alt={alt} width={width} loading="lazy" />
</picture>
