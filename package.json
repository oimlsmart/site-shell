{
  "name": "@oimlsmart/site-shell",
  "version": "0.1.5",
  "description": "The OIML SMART house shell — the one SSOT for the chrome of every OIML SMART site (federation header, component-local nav, logo hero, docs layout, footer, design tokens)",
  "repository": {
    "type": "git",
    "url": "https://github.com/oimlsmart/site-shell"
  },
  "type": "module",
  "scripts": {
    "gate": "node scripts/gate.mjs",
    "gate:render": "npm --prefix test/fixture run check:render"
  },
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*",
    "./tokens.css": "./src/styles/tokens.css",
    "./data/*": "./src/data/*",
    "./blueprint.css": "./src/styles/blueprint.css"
  },
  "files": [
    "src",
    "scripts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "astro": ">=5",
    "vue": ">=3.5"
  }
}
