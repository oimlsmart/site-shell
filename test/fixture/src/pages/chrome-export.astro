---
/**
 * The chrome-export page — renders ONLY the federation header and
 * footer so scripts/export-chrome.mjs can extract them (with the head's
 * asset tags) for injection into foreign-built sites (TODO.fix/07:
 * full-document generators like the glossarist concept-browser and the
 * Jekyll specs site that cannot mount the shell's Astro components).
 * Not linked from anywhere; the fixture build emits it as
 * /chrome-export/index.html. The markers come from the shared contract
 * module — the same constants export-chrome.mjs slices on.
 */
import SiteHeader from '@oimlsmart/site-shell/components/SiteHeader.astro'
import SiteFooter from '@oimlsmart/site-shell/components/SiteFooter.astro'
import { THEME_BOOTSTRAP } from '@oimlsmart/site-shell'
import { CHROME_MARKERS } from '@oimlsmart/site-shell/data/chrome.mjs'
import '../styles/app.css'
---

<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <title>chrome-export</title>
</head>
<body>
  <Fragment set:html={`<!-- ${CHROME_MARKERS.header.start} -->`} />
  <SiteHeader />
  <Fragment set:html={`<!-- ${CHROME_MARKERS.header.end} -->`} />
  <Fragment set:html={`<!-- ${CHROME_MARKERS.footer.start} -->`} />
  <SiteFooter />
  <Fragment set:html={`<!-- ${CHROME_MARKERS.footer.end} -->`} />
  <script is:inline set:html={THEME_BOOTSTRAP} />
</body>
</html>
